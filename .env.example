# LLM API Keys (comma-separated list of provider keys)
# Public identifiers will be key_1, key_2, ...
LLM_API_KEYS=your_key_1,your_key_2

# LLM Model Configuration
LLM_MODEL=gemini/gemini-3-flash-preview

# Database URL (SQLite only)
# Local development default: sqlite:///./app.db
# Docker default: sqlite:////data/app.db
DATABASE_URL=sqlite:////data/app.db

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Failure Simulation Header Toggle (true/false)
ENABLE_FAILURE_SIMULATION=true

# Cache Toggle
CACHE_ENABLED=true
